<script>
    function exportJadwal() {
        const checkedBoxes = document.querySelectorAll('.item-checkbox:checked');
        const exportTypeInput = document.getElementById('exportType');
        const exportIdsInput = document.getElementById('exportIds');
        const form = document.getElementById('exportForm');

        if (checkedBoxes.length > 0) {
            // Export Selected
            const ids = Array.from(checkedBoxes).map(cb => cb.value).join(',');
            exportTypeInput.value = 'selected';
            exportIdsInput.value = ids;
            
            if(confirm('Export ' + checkedBoxes.length + ' data terpilih?')) {
                form.submit();
            }
        } else {
            // Export All (Filtered)
            exportTypeInput.value = 'all';
            exportIdsInput.value = '';
            
            if(confirm('Export semua data jadwal sesuai filter tahun saat ini?')) {
                form.submit();
            }
        }
    }
</script>
{{-- Script Preservation - Logic kept intact --}}
<script>
    // Fungsi untuk buka form edit sebuah baris
    function editRow(id) {
        document.querySelectorAll('tr[id^="edit-form-"]').forEach(function(row) {
            row.classList.add('hidden');
            let otherId = row.id.replace('edit-form-', '');
            let otherDisplay = document.getElementById('row-' + otherId);
            if (otherDisplay) otherDisplay.classList.remove('hidden');
        });

        const displayRow = document.getElementById('row-' + id);
        const editRowEl = document.getElementById('edit-form-' + id);
        if (displayRow) displayRow.classList.add('hidden');
        if (editRowEl) {
            editRowEl.classList.remove('hidden');
            editRowEl.scrollIntoView({ behavior: 'smooth', block: 'center' });
            const firstInput = editRowEl.querySelector('select, input, textarea, button');
            if (firstInput) firstInput.focus();
        }
    }

    function cancelEditRow(id) {
        const editRowEl = document.getElementById('edit-form-' + id);
        const displayRow = document.getElementById('row-' + id);
        if (editRowEl) editRowEl.classList.add('hidden');
        if (displayRow) displayRow.classList.remove('hidden');
    }

    // Hide edit on outside click
    document.addEventListener('click', function(event) {
        let isEditButton = !!event.target.closest('button[onclick^="editRow"]');
        let isEditForm = !!event.target.closest('tr[id^="edit-form-"]');

        if (!isEditButton && !isEditForm) {
            document.querySelectorAll('tr[id^="edit-form-"]').forEach(function(row) {
                if (!row.classList.contains('hidden')) {
                    row.classList.add('hidden');
                    let id = row.id.replace('edit-form-', '');
                    let displayRow = document.getElementById('row-' + id);
                    if (displayRow) displayRow.classList.remove('hidden');
                }
            });
        }
    });

    const checkAll = document.getElementById('checkAll');
    const bulkDeleteBtn = document.getElementById('btnBulkDelete');

    function getItemCheckboxes() { return document.querySelectorAll('.item-checkbox'); }

    function updateBulkButtonState() {
        if (!bulkDeleteBtn) return;
        const checkedCount = Array.from(getItemCheckboxes()).filter(cb => cb.checked).length;
        bulkDeleteBtn.disabled = checkedCount === 0;
    }

    checkAll.addEventListener('change', function() { 
        getItemCheckboxes().forEach(cb => cb.checked = this.checked); 
        updateBulkButtonState();
    });

    function updateCheckAllState() {
        const items = getItemCheckboxes();
        if (items.length === 0) { checkAll.checked = false; updateBulkButtonState(); return; }
        checkAll.checked = Array.from(items).every(cb => cb.checked);
        updateBulkButtonState();
    }

    document.addEventListener('change', function(e) { 
        if (e.target && e.target.matches('.item-checkbox')) { 
            updateCheckAllState(); 
        } 
    });

    updateCheckAllState();

    // Auto Search
    const searchInput = document.getElementById('search');
    const form = document.getElementById('searchForm');
    let typingTimer;
    searchInput.addEventListener('input', function() {
        clearTimeout(typingTimer);
        typingTimer = setTimeout(() => { form.submit(); }, 1000);
    });

    // Tambah Baris Baru Logic
    function tambah() {
        const panel = document.getElementById('tahunbulk');
        if (panel) panel.classList.remove('hidden');

        const tpl = document.getElementById('tplNewJadwalRow');
        const tbody = document.getElementById('jadwalTable');
        if (!tpl || !tbody) return;

        // Clone template and insert at top
        const clone = tpl.content.cloneNode(true);
        tbody.insertBefore(clone, tbody.firstChild);

        refreshSimpanBarisBaru();
    }

    function removeNewRow(btn) {
        const tr = btn.closest('tr');
        if (tr) tr.remove();
        
        const tbody = document.getElementById('jadwalTable');
        const panel = document.getElementById('tahunbulk');
        const masihAdaBaru = tbody && tbody.querySelector('tr.new-row');
        if (!masihAdaBaru && panel) { panel.classList.add('hidden'); }
        
        refreshSimpanBarisBaru();
    }

    function refreshSimpanBarisBaru() {
        const tahun = document.getElementById('tahun_bulk');
        const btn = document.getElementById('btnSimpanBarisBaru');
        if (!btn) return;

        const hasTahun = tahun && tahun.value !== '';
        const hasRowBaru = document.querySelector('#jadwalTable tr.new-row') !== null;
        btn.disabled = !(hasTahun && hasRowBaru);
        
        // Visual feedback for disabled button
        if(btn.disabled) { btn.classList.add('opacity-50', 'cursor-not-allowed'); } 
        else { btn.classList.remove('opacity-50', 'cursor-not-allowed'); }
    }

    document.addEventListener('DOMContentLoaded', function() {
        refreshSimpanBarisBaru();
        const tahun = document.getElementById('tahun_bulk');
        if (tahun) tahun.addEventListener('change', refreshSimpanBarisBaru);
    });
</script>
</x-layout.layout>
